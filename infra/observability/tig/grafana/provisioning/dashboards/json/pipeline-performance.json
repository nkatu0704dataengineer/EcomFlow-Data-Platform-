          "query": "from(bucket: \"ecomflow_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\" ] =~ /^airflow\\.dagrun\\.duration\\.success\\..+$/)\n  |> filter(fn: (r) => r[\"_field\"] == \"p50\" or r[\"_field\"] == \"p95\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"dag_duration\")",
          "refId": "A"
        }
      ],
